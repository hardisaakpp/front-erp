# API Backend URL para desarrollo: /api usa el proxy de Vite → target en vite.config.ts (p. ej. 210.17.1.53:5053).
# Si usas http://localhost:5053/api, el backend debe estar corriendo en tu máquina en el puerto 5053.
VITE_API_URL=/api
VITE_CAJA_CHICA_API_URL=http://localhost:8080/api
VITE_SLAYER_API_URL=http://localhost:5110/api

# MBA3 API: en desarrollo usar proxy /mba3-api → localhost:8000 para evitar CORS.
VITE_MBA3_API_BASE_URL=/mba3-api

# Otras variables de entorno de desarrollo
# VITE_APP_NAME=SCNexus Dev
# VITE_ENABLE_ANALYTICS=false
