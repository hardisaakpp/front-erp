# API Backend URL para desarrollo: /api usa el proxy de Vite → target en vite.config.ts.
# Core (login, etc.) y MBA3 (/Auth/me): en dev ambos /api; el proxy enruta por path.
VITE_API_URL=/api
#VITE_API_URL=http://192.168.2.12:8080/api

VITE_CORE_API_URL=/api
#VITE_CORE_API_URL=http://192.168.2.12:8080/api
#VITE_CORE_API_URL=http://210.17.1.53:5053/api
VITE_CORE_PROXY_TARGET=http://192.168.2.12:8080
#VITE_CORE_PROXY_TARGET=http://210.17.1.53:5053
#Apps pruebas / Core

VITE_MBA3_API_URL=/api
VITE_MBA3_API_BASE_URL=/mba3-api
# Servidor de pruebas MBA3 Consultas
#VITE_MBA3_PROXY_TARGET=http://210.17.1.55:8000
VITE_MBA3_PROXY_TARGET=http://localhost:8000
# Endpoint local de capabilities: /Auth/me (sin prefijo /api)
VITE_AUTH_ME_PROXY_TARGET=http://localhost:8080

VITE_CAJA_CHICA_API_URL=http://localhost:8080/api
VITE_SLAYER_API_URL=http://localhost:5110/api

# API del Maestro de Artículos
VITE_MAESTRO_API_TARGET=http://210.17.1.55:8004/

# API de empleados para módulo Gestión Usuarios
VITE_STORE_EMPLOYEES_API_URL=/employees-api/store_employees.php
VITE_STORE_EMPLOYEES_PROXY_TARGET=http://localhost:8080