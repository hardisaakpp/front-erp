# Copiar a `.env.development` y ajustar. Reiniciar `npm run dev` tras cada cambio.
#
# Regla: rutas relativas en VITE_* (bundle). Hosts reales solo en VITE_*_PROXY_TARGET.
# Ver docs/ENV.md

VITE_APP_BASE_PATH=/

# --- Bundle: mismas rutas que .env.production.example ---
VITE_API_URL=/api
VITE_CORE_API_URL=/api
VITE_MBA3_API_URL=/api
VITE_MBA3_API_BASE_URL=/api/mba3
VITE_CONCILIACION_API_URL=/conciliacion-api
VITE_CAJA_CHICA_API_URL=/caja-chica-api
VITE_ARTICULO_SCAN_API_URL=/scan-api
VITE_INVENTARIO_API_URL=/inventario-api
VITE_PROMOCION_SOBRES_API_URL=/promocion-sobres-api
VITE_MAESTRO_API_URL=/maestro-api
# Preferencias UI: rutas /api/users/preferences (base vacía; no usar /api/mba3 aquí)
# VITE_PREFERENCES_API_URL=

# --- Proxy Vite (localhost o host.docker.internal en docker-compose.dev.yml) ---
VITE_CORE_PROXY_TARGET=http://192.168.2.12:8080
VITE_MBA3_PROXY_TARGET=http://localhost:8000
VITE_AUTH_ME_PROXY_TARGET=http://localhost:8000
VITE_CAJA_CHICA_PROXY_TARGET=http://192.168.2.153:8092
VITE_PYG_PROXY_TARGET=http://localhost:5171
VITE_PYG_PROXY_PREFIX=/api
VITE_ARTICULO_SCAN_PROXY_TARGET=http://localhost:8080
VITE_INVENTARIO_PROXY_TARGET=http://localhost:8082
VITE_PROMOCION_SOBRES_PROXY_TARGET=http://localhost:8083
VITE_CONCILIACION_PROXY_TARGET=http://127.0.0.1:8005
VITE_MAESTRO_API_TARGET=http://localhost:8001
VITE_SLAYER_PROXY_TARGET=http://192.168.2.153:8093

# Con `docker-compose.dev.yml` + red `mba3-nexus_edge`:
# VITE_MBA3_PROXY_TARGET=http://mba3-api:8000
# VITE_AUTH_ME_PROXY_TARGET=http://mba3-api:8000

# Subruta legacy (codigoqr): VITE_APP_BASE_PATH=/scnexus-front/

# VITE_ALLOW_UNAUTHENTICATED=false
