# Copiar a `.env.development` y ajustar. Reiniciar `npm run dev` tras cada cambio.
#
# Base path de la SPA (usar `/` en local). En servidor legacy puedes publicar bajo subruta:
# VITE_APP_BASE_PATH=/scnexus-front/

# --- PYG (API dockerizada, ej. mapa de puertos 5171:8080 en el host) ---
# Destino del proxy de Vite para las peticiones del navegador a `/pyg-api/*`.
VITE_PYG_PROXY_TARGET=http://localhost:5171
# Cómo reescribir la ruta hacia el backend. Por defecto `/api`:
#   GET /pyg-api/uploads  →  GET http://localhost:5171/api/uploads
# Si tu servicio no usa prefijo `/api`, deja la variable vacía en tu `.env.development`:
# VITE_PYG_PROXY_PREFIX=
VITE_PYG_PROXY_PREFIX=/api

# Llamada directa desde el navegador (sin proxy). Requiere CORS en el backend para el origen del frontend (p. ej. http://localhost:3000).
# Si la usas, la URL debe incluir el prefijo donde viven los controladores PYG:
# VITE_PYG_API_URL=http://localhost:5171/api

# --- Importante: no mezclar con el Core (login / usuarios) ---
# `VITE_API_URL` / `VITE_CORE_API_URL` apuntan al API **Core**, no al microservicio PYG.
# Poner aquí solo `http://localhost:5171` desviaría el login hacia PYG y rompería la autenticación.

# Si ves 403 en /pyg-api/* pero la pantalla /pyg carga: el router en dev puede omitir permisos (por defecto).
# Pon esto en false para que el guard coincida con el API y no entres al módulo sin permisos del Core.
# VITE_ALLOW_UNAUTHENTICATED=false

# --- Artículo scaner (ruta interna `/articulo-scaner` bajo el base path; GET /api/v1/warehouses, POST /api/v1/scan/resolve) ---
# Proxy Vite: el navegador usa `/scan-api/*` y Vite reenvía al backend (quita el prefijo `/scan-api`).
# VITE_ARTICULO_SCAN_PROXY_TARGET=http://localhost:8080
# Sin proxy: URL absoluta del microservicio (requiere CORS):
# VITE_ARTICULO_SCAN_API_URL=http://localhost:8080

# --- Inventario StoreControl (.NET; GET /api/v1/inventory-plannings, /api/v1/inventories, etc.) ---
# Proxy Vite: el navegador usa `/inventario-api/*` y Vite reenvía al backend quitando `/inventario-api`.
VITE_INVENTARIO_API_URL=/inventario-api
VITE_INVENTARIO_PROXY_TARGET=http://localhost:8082
# Si corres con `dotnet run --urls http://localhost:5088`, usa:
# VITE_INVENTARIO_PROXY_TARGET=http://localhost:5088

# --- Otros proxies de dev (referencia) ---
# VITE_CORE_PROXY_TARGET=http://localhost:5053
# VITE_MBA3_PROXY_TARGET=http://localhost:8000
# Con `docker-compose.dev.yml` + red `mba3-nexus_edge` (mba3-consultas), el proxy en el contenedor Node usa el hostname Docker:
# VITE_MBA3_PROXY_TARGET=http://mba3-api:8000
# VITE_AUTH_ME_PROXY_TARGET=http://mba3-api:8000
# El navegador sigue hablando con el dev server en localhost:3000; no pongas `mba3-api` en URLs que consuma el bundle en el cliente.
