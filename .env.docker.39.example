# Plantilla para srv-mabletest (192.168.2.39 / codigoqr.mabelgroup.com.ec).
# Copiar a `.env` en /storage/scnexus-front antes de `docker compose build`.
#
# Los *_UPSTREAM se hornean en Nginx al build; tras cambiar este archivo:
#   docker compose build --no-cache && docker compose up -d

SCNEXUS_FRONT_PORT=8081
VITE_APP_BASE_PATH=/scnexus-front/

# MBA3: GET /api/Auth/me (capabilities), /api/mba3/*, preferencias UI
MBA3_UPSTREAM=http://192.168.2.153:8000

# Core: login y resto de /api/Auth/* (excepto /me)
CORE_UPSTREAM=http://192.168.2.12:8080

# Caja chica / empleados / uploads
CAJA_CHICA_UPSTREAM=http://192.168.2.211:8092

# Artículo scanner (srv-mabuiosapi)
SCAN_API_UPSTREAM=http://192.168.2.153:8080

# Promoción sobres — API en srv-mabuiosapi (mismo host que SCAN). NO usar host.docker.internal en Linux.
PROMOCION_SOBRES_UPSTREAM=http://192.168.2.153:8083

# Opcionales (ajustar si el servicio corre en .39 o en otra IP)
PYG_UPSTREAM=http://host.docker.internal:5171
INVENTARIO_UPSTREAM=http://host.docker.internal:8082
CONCILIACION_UPSTREAM=http://host.docker.internal:8005
MAESTRO_UPSTREAM=http://host.docker.internal:8001
SLAYER_UPSTREAM=http://host.docker.internal:8093
