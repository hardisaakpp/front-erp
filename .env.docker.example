# Copiar a `.env` en la raíz del proyecto (junto a docker-compose.yml).
# Usado en `docker compose build` para build-args de Nginx y Vite.
#
# Regla: localhost / host.docker.internal en desarrollo; IPs de red en producción.
# El bundle del navegador sigue usando rutas relativas (/api, /api/mba3); solo cambian upstreams del proxy.

# --- Puerto publicado del contenedor en el host ---
SCNEXUS_FRONT_PORT=8081

# --- Base path de la SPA (raíz intranet: / ; subruta legacy: /scnexus-front/) ---
VITE_APP_BASE_PATH=/

# --- Upstreams Nginx (producción en contenedor) ---
# Servicios en el mismo host que Docker Desktop / Linux con host-gateway:
MBA3_UPSTREAM=http://host.docker.internal:8000
PYG_UPSTREAM=http://host.docker.internal:5171
SCAN_API_UPSTREAM=http://host.docker.internal:8080
PROMOCION_SOBRES_UPSTREAM=http://host.docker.internal:8083
INVENTARIO_UPSTREAM=http://host.docker.internal:8082
CONCILIACION_UPSTREAM=http://host.docker.internal:8005
MAESTRO_UPSTREAM=http://host.docker.internal:8001
# Servicios en otros servidores de la red (intranet):
CORE_UPSTREAM=http://192.168.2.12:8080
CAJA_CHICA_UPSTREAM=http://192.168.2.211:8092
SLAYER_UPSTREAM=http://192.168.2.153:8093

# Ejemplo servidor aplicaciones (MBA3 en IP fija en lugar de host local):
# MBA3_UPSTREAM=http://192.168.2.153:8000
# SCAN_API_UPSTREAM=http://192.168.2.153:8080

# --- Solo docker-compose.dev.yml (proxy Vite; no afectan el build de prod) ---
# VITE_MBA3_PROXY_TARGET=http://localhost:8000
# VITE_CORE_PROXY_TARGET=http://192.168.2.12:8080
