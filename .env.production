# ============================================
# VARIABLES DE ENTORNO PARA PRODUCCIÓN
# ============================================
# IMPORTANTE: Con HTTPS en el navegador, NO uses http:// ni IPs privadas aquí.
# Esas URLs se incrustan en el JS del dist: el cliente las llama directo → Mixed Content / inaccesibles.
# Si Apache/Nginx ya hace proxy de /api hacia Core/MBA3, usa rutas relativas (recomendado).
#
# API Caja Chica: si los endpoints viven bajo el mismo Core en /api/..., deja /api.
# Si Caja Chica es otro servicio, añade un location en nginx (ej. /caja-chica-api/) y apunta esta var ahí.
VITE_CAJA_CHICA_API_URL=/caja-chica-api

# Core (login, /api/Auth/* salvo /me) y instancia mba3Api (/api/Auth/me) — el proxy del servidor enruta.
VITE_API_URL=/api
VITE_CORE_API_URL=/api
VITE_MBA3_API_URL=/api

# API Backend MBA3 Consultas (módulo mba3-consultas): prefijo público bajo el mismo dominio
VITE_MBA3_API_BASE_URL=/api/mba3

# API Backend Conciliación Tesorería (puerto 8002)
VITE_CONCILIACION_API_BASE_URL=/api/conciliacion

# API Backend Preferencias de Usuario (puede ser la misma que MBA3)
VITE_PREFERENCES_API_URL=/api/mba3

# Nombre de la aplicación
VITE_APP_NAME=SCNexus

# Prefijo público de esta SPA en el dominio compartido (build-time; debe coincidir con Apache/Nginx).
VITE_APP_BASE_PATH=/scnexus-front/

# Habilitar analytics (opcional)
# VITE_ENABLE_ANALYTICS=true
