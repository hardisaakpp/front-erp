# Plantilla para build de producción (npm run build / Docker).
# Rutas relativas al dominio HTTPS; IPs solo en Nginx (*_UPSTREAM) o .env.docker.example.

# Subruta servidor .39 / local Docker (codigoqr):
VITE_APP_BASE_PATH=/scnexus-front/
# Intranet raíz:
# VITE_APP_BASE_PATH=/

# Opcional: forzar URL de login al expirar sesión (por defecto: origin + base path + /login)
# VITE_LOGIN_REDIRECT_URL=https://codigoqr.mabelgroup.com.ec/scnexus-front/login

VITE_API_URL=/api
VITE_CORE_API_URL=/api
VITE_MBA3_API_URL=/api
VITE_MBA3_API_BASE_URL=/api/mba3
VITE_CONCILIACION_API_URL=/conciliacion-api
VITE_SLAYER_API_URL=/api/slayer
VITE_CAJA_CHICA_API_URL=/caja-chica-api
VITE_ARTICULO_SCAN_API_URL=/scan-api
VITE_INVENTARIO_API_URL=/inventario-api
VITE_PROMOCION_SOBRES_API_URL=/promocion-sobres-api
VITE_MAESTRO_API_URL=/maestro-api
VITE_APP_NAME=SCNexus
