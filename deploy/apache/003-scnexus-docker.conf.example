# Ejemplo de referencia para el corte Apache en srv-mabuiosapi.
# NO copiar ciegamente: comparar con /etc/apache2/sites-enabled/003-scnexus.conf
#
# Antes: Apache :443 → Nginx :3001 → root /storage/scnexus/dist
# Después: Apache :443 → contenedor scnexus-front :8082 (Nginx dentro del contenedor + proxy APIs)
#
# Tras editar:
#   sudo apache2ctl configtest
#   sudo systemctl reload apache2

<VirtualHost *:443>
    ServerName scnexus.mabelgroup.com.ec

    # ... SSLCertificateFile, SSLCertificateKeyFile, etc. (mantener los del archivo actual)

    ProxyPreserveHost On
    RequestHeader set X-Forwarded-Proto "https"
    RequestHeader set X-Forwarded-Port "443"

    # Todo el sitio SCNexus al front Docker (SPA + /api, /api/mba3, /caja-chica-api, …)
    ProxyPass / http://127.0.0.1:8082/
    ProxyPassReverse / http://127.0.0.1:8082/

    ErrorLog ${APACHE_LOG_DIR}/scnexus-error.log
    CustomLog ${APACHE_LOG_DIR}/scnexus-access.log combined
</VirtualHost>

# Rollback: restaurar 003-scnexus.conf.bak (destino anterior, ej. http://127.0.0.1:3001/)
