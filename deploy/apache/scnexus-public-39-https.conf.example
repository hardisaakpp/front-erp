<VirtualHost *:80>
    ServerName codigoqr.mabelgroup.com.ec

    RewriteEngine On
    RewriteRule ^ https://codigoqr.mabelgroup.com.ec%{REQUEST_URI} [L,R=301,NE]
</VirtualHost>

<IfModule mod_ssl.c>
<VirtualHost *:443>
    ServerName codigoqr.mabelgroup.com.ec

    SSLEngine on
    # Reutiliza el wildcard/certificado corporativo ya instalado en el servidor.
    SSLCertificateFile /etc/ssl/certs/server.crt
    SSLCertificateKeyFile /etc/ssl/private/server.key
    SSLCertificateChainFile /etc/ssl/certs/bundle.crt

    ProxyPreserveHost On
    ProxyRequests Off

    # --- Legado PHP (/checkin) ---
    # IMPORTANTE: estas reglas deben ir ANTES de ProxyPass / para que no lo capture la SPA.
    # 1) Excluir /checkin del proxy al contenedor:
    ProxyPass /checkin !
    # 2) Publicar carpeta legacy en el host (ajustar ruta real):
    Alias /checkin /var/www/codigoqr-legacy/checkin
    <Directory /var/www/codigoqr-legacy/checkin>
        Options Indexes FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
    # 3) Asegurar ejecución PHP en ese path (mod_php o php-fpm según el servidor).
    #    Ejemplo php-fpm:
    # <FilesMatch \.php$>
    #     SetHandler "proxy:unix:/run/php/php8.2-fpm.sock|fcgi://localhost"
    # </FilesMatch>

    # Frontend SPA servido por el contenedor (Nginx interno en 127.0.0.1:8081)
    ProxyPass        / http://127.0.0.1:8081/
    ProxyPassReverse / http://127.0.0.1:8081/

    # Mantener protocolo original para backends que validan esquema
    RequestHeader set X-Forwarded-Proto "https"

    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
</VirtualHost>
</IfModule>
