# active.env para instancia PARALELA de prueba (front + core-paralelo + inventario)
# en srv-mabuiosapi. Basado en deploy/env/local.env.example (config real del front
# que ya corre en 8090), cambiando solo Core e Inventario.

UPSTREAM_MBA3=http://192.168.2.153:8000

# Apunta al core-paralelo desplegado en este mismo servidor (puerto 5060),
# no al Core real de producción.
UPSTREAM_CORE=http://192.168.2.153:5060
CORE_PROXY_HOST=192.168.2.153:5060

UPSTREAM_PYG=http://172.30.152.155:5171
UPSTREAM_MAESTRO=http://172.30.152.155:8004
UPSTREAM_CONCILIACION=http://172.30.152.155:8005
UPSTREAM_REPOSICION=http://172.30.152.155:8006/
UPSTREAM_SCAN=http://192.168.2.153:8080

# api-inventario desplegado hoy en este mismo servidor, puerto 8094.
UPSTREAM_INVENTARIO=http://192.168.2.153:8094
UPSTREAM_INV_PLANES=http://192.168.2.153:8094

UPSTREAM_PROMOCION_SOBRES=http://172.30.152.155:8083
UPSTREAM_CAJA_CHICA=http://172.30.159.99:8092
UPSTREAM_SLAYER=http://210.17.1.59:8011
UPSTREAM_RULETA=http://172.30.159.99:5055/
UPSTREAM_TRANSACCIONES=http://172.30.152.155:8007

# Despliegue paralelo: puerto y nombre de contenedor distintos a los ya usados
# (8090 = scnexus-front, 9090 = scnexus-front-paralelo).
SCNEXUS_FRONT_PORT=8091
CONTAINER_NAME=scnexus-front-inv-test

# Obligatorio para despliegues standalone (no bajo /scnexus-front/): sin esto,
# el build usa el default del docker-compose.yml (/scnexus-front/) y rompe
# rutas de la SPA que asumen raíz del dominio.
VITE_APP_BASE_PATH=/
