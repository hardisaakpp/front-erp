# Perfil DESA (desa-mabuiosapp) — cp desa.env.example active.env
# host.docker.internal = servicios en el mismo host que Docker.
# Ajustar UPSTREAM_* según `docker ps` en el servidor.
#
# Puertos en DESA (referencia):
#   5053  scnexus-core-api
#   8081  cajachica-staging  → UPSTREAM_CAJA_CHICA (backend, no es el front)
#   5171  scnexus-pyg-api (host; puerto interno del contenedor 8080)
#   8005  app-conciliacion
#   8004  app-maestro
#   8082  SCNexus front (este contenedor) → SCNEXUS_FRONT_PORT

UPSTREAM_CORE=http://host.docker.internal:5053
# Host que recibe scnexus-core-api (login /api/Auth/*). Debe coincidir con el puerto de UPSTREAM_CORE.
CORE_PROXY_HOST=host.docker.internal:5053
UPSTREAM_MBA3=http://host.docker.internal:8000
UPSTREAM_MBA3_AUTH=http://host.docker.internal:8000
UPSTREAM_CAJA_CHICA=http://host.docker.internal:8081
UPSTREAM_PYG=http://host.docker.internal:5171
UPSTREAM_PYG_PREFIX=/api
UPSTREAM_MAESTRO=http://host.docker.internal:8004
UPSTREAM_CONCILIACION=http://host.docker.internal:8005
# Inventario: NO usar :8082 (ese puerto publica el front SCNexus). Ajustar cuando exista el backend.
UPSTREAM_INVENTARIO=http://host.docker.internal:8086
# Scan / promoción / slayer: descomentar cuando existan en DESA (docker ps)
UPSTREAM_SCAN=http://host.docker.internal:8080
# UPSTREAM_PROMOCION_SOBRES=http://host.docker.internal:8083
# UPSTREAM_SLAYER=http://host.docker.internal:8093

# Front SCNexus (Nginx + SPA). No usar 8081 (cajachica-staging).
SCNEXUS_FRONT_PORT=8082
