# otro nombre/puerto), define CONTAINER_NAME y otro SCNEXUS_FRONT_PORT en un
# active.env aparte. Vacía -> se despliega igual que siempre (scnexus-front).
#CONTAINER_NAME=scnexus-front-paralelo