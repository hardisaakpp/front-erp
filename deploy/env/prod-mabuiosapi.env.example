# Perfil PRODUCCIÓN — srv-mabuiosapi (scnexus.mabelgroup.com.ec)
# cp prod-mabuiosapi.env.example active.env
#
# Cada UPSTREAM_* debe coincidir con el backend real (probar con curl desde el host y desde el contenedor).
# No copiar IPs al azar: validar con docker ps / Nginx host :3001 (empleados PHP).
#
# docker compose -f docker-compose.yml -f docker-compose.prod-network.yml \
#   --env-file deploy/env/active.env up -d --build
# docker network connect bridge scnexus-front

VITE_APP_BASE_PATH=/

# Core Auth + /api/* (mismo que Apache viejo 003-scnexus.conf)
UPSTREAM_CORE=http://192.168.2.12:8080
CORE_PROXY_HOST=192.168.2.12:8080

# MBA3 — red mba3-nexus_edge (NO host.docker.internal:8000)
UPSTREAM_MBA3=http://mba3-api:8000
UPSTREAM_MBA3_AUTH=http://mba3-api:8000

# Cajachica — red bridge 172.17.0.2 (tras connect bridge)
UPSTREAM_CAJA_CHICA=http://172.17.0.2:8092

# PYG — red scnexus-pyg_default. Puerto INTERNO del contenedor es 8080 (docker ps: 5171->8080/tcp).
# NO usar :5171 ni host.docker.internal:5171 desde otro contenedor.
UPSTREAM_PYG=http://scnexus-pyg-api:8080
UPSTREAM_PYG_PREFIX=/api

# Empleados tiendas — PHP en Nginx HOST :3001 (alias /opt/klienteV1/cws/api/), NO cajachica
UPSTREAM_EMPLOYEES=http://host.docker.internal:3001

# Conciliación — red conciliacion-bancaria_default (NO host.docker.internal:8005 — 504)
# docker ps app-conciliacion → puerto INTERNO (suele ser 8080 si publica 8005->8080/tcp)
UPSTREAM_CONCILIACION=http://app-conciliacion:8080

# Maestro — si 504, igual que conciliación: red articulomaestro_default + puerto interno
UPSTREAM_MAESTRO=http://host.docker.internal:8004
UPSTREAM_SCAN=http://host.docker.internal:8080
UPSTREAM_SLAYER=http://host.docker.internal:8093
UPSTREAM_PROMOCION_SOBRES=http://host.docker.internal:8083
# Inventario: NO usar :8082 (lo publica el front). Ajustar cuando exista el backend.
# UPSTREAM_INVENTARIO=http://host.docker.internal:8086

SCNEXUS_FRONT_PORT=8082
