# Perfil PRODUCCIÓN — srv-mabuiosapi (scnexus.mabelgroup.com.ec)
# cp prod-mabuiosapi.env.example active.env
#
# Validado mar 2026 en srv-mabuiosapi:
#   Core login /api/Auth/* → 192.168.2.12:8080 (200). :5053 local devuelve 500 en login.
#   MBA3 mba3-api:8000 vía red mba3-nexus_edge (NO host.docker.internal:8000 — timeout)
#   Cajachica 172.17.0.2:8092 vía docker network connect bridge tras el up
#   :5053 = scnexus-core-api local (swagger OK); no usar para Auth de prod si falla login.
#
# docker compose -f docker-compose.yml -f docker-compose.prod-network.yml \
#   --env-file deploy/env/active.env up -d --build

VITE_APP_BASE_PATH=/

UPSTREAM_CORE=http://192.168.2.12:8080
CORE_PROXY_HOST=192.168.2.12:8080

UPSTREAM_MBA3=http://mba3-api:8000
UPSTREAM_MBA3_AUTH=http://mba3-api:8000

UPSTREAM_CAJA_CHICA=http://172.17.0.2:8092

UPSTREAM_PYG=http://host.docker.internal:5171
UPSTREAM_PYG_PREFIX=/api
UPSTREAM_MAESTRO=http://host.docker.internal:8004
UPSTREAM_CONCILIACION=http://host.docker.internal:8005
UPSTREAM_SCAN=http://host.docker.internal:8080
UPSTREAM_SLAYER=http://host.docker.internal:8093
UPSTREAM_PROMOCION_SOBRES=http://host.docker.internal:8083
# Inventario: NO usar :8082 (lo publica el front). Ajustar cuando exista el backend.
# UPSTREAM_INVENTARIO=http://host.docker.internal:8086

SCNEXUS_FRONT_PORT=8082
