# Nginx dentro del contenedor SCNexus (intranet / servidor de aplicaciones).
# Upstreams: variables ${UPSTREAM_*} sustituidas por docker-entrypoint.sh al arrancar.
# Referencia host sin Docker: deploy/nginx/scnexus-host.conf.example

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # =========================
    # AUTH/me -> MBA3 (capabilities)
    # =========================
    location = /api/Auth/me {
        proxy_pass ${UPSTREAM_MBA3};
        proxy_http_version 1.1;
        proxy_connect_timeout 10s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    location = /api/auth/me {
        proxy_pass ${UPSTREAM_MBA3};
        proxy_http_version 1.1;
        proxy_connect_timeout 10s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    # =========================
    # AUTH -> CORE (login). Sin Host $host: equivale a changeOrigin del proxy Vite.
    # =========================
    location /api/Auth/ {
        proxy_pass ${UPSTREAM_CORE};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    # Preferencias UI -> MBA3 (antes del location /api/ genérico)
    location /api/users/preferences {
        proxy_pass ${UPSTREAM_MBA3};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    # =========================
    # SSE MBA3 (antes de /api/mba3/)
    # =========================
    location = /api/mba3/notificaciones/stream {
        rewrite ^/api/mba3(.*)$ $1 break;
        proxy_pass ${UPSTREAM_MBA3};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
        proxy_set_header Connection '';
        chunked_transfer_encoding off;
    }

    # =========================
    # MBA3 Consultas (/api/mba3/* -> backend sin prefijo)
    # =========================
    location /api/mba3/ {
        rewrite ^/api/mba3(.*)$ $1 break;
        proxy_pass ${UPSTREAM_MBA3};
        proxy_http_version 1.1;
        client_max_body_size 50M;
        proxy_connect_timeout 120s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    # =========================
    # Caja Chica
    # =========================
    location /caja-chica-api/ {
        rewrite ^/caja-chica-api(.*)$ /api$1 break;
        proxy_pass ${UPSTREAM_CAJA_CHICA};
        proxy_http_version 1.1;
        client_max_body_size 50M;
        proxy_connect_timeout 120s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    location ^~ /uploads/ {
        proxy_pass ${UPSTREAM_CAJA_CHICA};
        proxy_http_version 1.1;
        client_max_body_size 50M;
        proxy_connect_timeout 120s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    # Adjuntos legacy Caja Chica (pre-Docker). Volumen: /var/lib/caja-chica-legacy (ver docker-compose.yml).
    location ^~ /media/scnexus-cajachica/ {
        alias /var/lib/caja-chica-legacy/;
    }

    # Empleados de tienda: API .NET. El frontend usa /employees-api como prefijo interno.
    location ^~ /employees-api/ {
        rewrite ^/employees-api/(.*)$ /$1 break;
        proxy_pass ${UPSTREAM_EMPLOYEES};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    # =========================
    # PYG
    # =========================
    location /pyg-api/ {
        rewrite ^/pyg-api(.*)$ /api$1 break;
        proxy_pass ${UPSTREAM_PYG};
        proxy_http_version 1.1;
        client_max_body_size 50M;
        proxy_connect_timeout 120s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    # =========================
    # Conciliación
    # =========================
    location /conciliacion-api/ {
        rewrite ^/conciliacion-api(.*)$ $1 break;
        proxy_pass ${UPSTREAM_CONCILIACION};
        proxy_http_version 1.1;
        client_max_body_size 50M;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    location /maestro-api/ {
        rewrite ^/maestro-api(.*)$ $1 break;
        proxy_pass ${UPSTREAM_MAESTRO};
        proxy_http_version 1.1;
        client_max_body_size 50M;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    # =========================
    # Reposiciones
    # =========================
    location /api/reposicion-api/ {
        rewrite ^/api/reposicion-api(.*)$ /api$1 break;
        proxy_pass ${UPSTREAM_REPOSICION};

        proxy_http_version 1.1;
        client_max_body_size 50M;
        proxy_connect_timeout 180s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    # =========================
    # Demanda OTB
    # =========================
    location /api/demanda-otb-api/ {
        rewrite ^/api/demanda-otb-api(.*)$ /api/v1$1 break;
        proxy_pass ${UPSTREAM_DEMANDA_OTB};

        proxy_http_version 1.1;
        client_max_body_size 50M;
        proxy_connect_timeout 180s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    # =========================
    # SCTransacciones (conciliación bancaria cajero/tesorería)
    # =========================
    location /transacciones-api/ {
        rewrite ^/transacciones-api(.*)$ $1 break;
        proxy_pass ${UPSTREAM_TRANSACCIONES};
        proxy_http_version 1.1;
        client_max_body_size 10M;
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }



    # =========================
    # Recepción de Mercadería
    # =========================
    location /api/recepcion-api/ {
        rewrite ^/api/recepcion-api(.*)$ /api$1 break;
        proxy_pass ${UPSTREAM_RECEPCION};
        proxy_http_version 1.1;
        client_max_body_size 50M;
        proxy_connect_timeout 180s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    # =========================
    # Transferencias Directas
    # =========================
    location /api/transferencias-directas-api/ {
        rewrite ^/api/transferencias-directas-api(.*)$ /api$1 break;
        proxy_pass ${UPSTREAM_TRANSFERENCIAS_DIRECTAS};
        proxy_http_version 1.1;
        client_max_body_size 50M;
        proxy_connect_timeout 180s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    # =========================
    # Recepción de Mercadería
    # =========================
    location /api/recepcion-api/ {
        rewrite ^/api/recepcion-api(.*)$ /api$1 break;
        proxy_pass ${UPSTREAM_RECEPCION};
        proxy_http_version 1.1;
        client_max_body_size 50M;
        proxy_connect_timeout 180s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    # =========================
    # Slayer (Caja Chica / SAP)
    # =========================
    location /slayer-api/ {
        rewrite ^/slayer-api(.*)$ /api$1 break;
        proxy_pass ${UPSTREAM_SLAYER};
        proxy_http_version 1.1;
        client_max_body_size 50M;
        proxy_connect_timeout 180s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    # =========================
    # mIAApi — asistente SCNEXUS AI (Cool-turito)
    # /mia-api/v1/preguntar -> ${UPSTREAM_MIA}/v1/preguntar
    # Timeout largo: el LLM tarda 2-25 s por respuesta (manual: cliente >= 120 s)
    # =========================
    location /mia-api/ {
        rewrite ^/mia-api(.*)$ $1 break;
        proxy_pass ${UPSTREAM_MIA};
        proxy_http_version 1.1;
        proxy_connect_timeout 30s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # =========================
    # Articulo Scanner
    # =========================
    location /scan-api/ {
        rewrite ^/scan-api(.*)$ $1 break;
        proxy_pass ${UPSTREAM_SCAN};
        proxy_http_version 1.1;
        client_max_body_size 50M;
        proxy_connect_timeout 120s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    # =========================
    # Promoción Sobres
    # =========================
    location /promocion-sobres-api/ {
        rewrite ^/promocion-sobres-api(.*)$ $1 break;
        proxy_pass ${UPSTREAM_PROMOCION_SOBRES};
        proxy_http_version 1.1;
        client_max_body_size 50M;
        proxy_connect_timeout 120s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    # =========================
    # Inventario
    # =========================
    location /inventario-api/ {
        rewrite ^/inventario-api(.*)$ $1 break;
        proxy_pass ${UPSTREAM_INVENTARIO};
        proxy_http_version 1.1;
        client_max_body_size 50M;
        proxy_connect_timeout 180s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    location /inv-planes-api/ {
        rewrite ^/inv-planes-api(.*)$ $1 break;
        proxy_pass ${UPSTREAM_INV_PLANES};
        proxy_http_version 1.1;
        client_max_body_size 50M;
        proxy_connect_timeout 180s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    # =========================
    # Campañas / Ruleta
    # =========================
    location /ruleta-api/ {
        rewrite ^/ruleta-api(.*)$ $1 break;
        proxy_pass ${UPSTREAM_RULETA};
        proxy_http_version 1.1;
        client_max_body_size 50M;
        proxy_connect_timeout 120s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    # =========================
    # CORE - resto de /api
    # =========================
    location /api/ {
        proxy_pass ${UPSTREAM_CORE};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Authorization $http_authorization;
    }

    # =========================
    # Transferencias Directas
    # =========================
    location /api/transferencias-directas-api/ {
        rewrite ^/api/transferencias-directas-api(.*)$ /api$1 break;
        proxy_pass ${UPSTREAM_TRANS_DIRECTAS};
        proxy_http_version 1.1;
        client_max_body_size 50M;
        proxy_connect_timeout 180s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }


    # =========================
    # SPA (debe ir después de los proxies de API)
    # Subruta /scnexus-front/ (VITE_APP_BASE_PATH=/scnexus-front/). ^~ evita que el regex
    # de estáticos abajo devuelva 404 al buscar /scnexus-front/assets/* en disco.
    # =========================
    location ^~ /scnexus-front/ {
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0";
        alias /usr/share/nginx/html/;
        try_files $uri $uri/ /scnexus-front/index.html;
    }

    location / {
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0";
        try_files $uri $uri/ /index.html;
    }

    location ~* ^/assets/.+\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
}
