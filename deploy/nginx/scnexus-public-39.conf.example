server {
    listen 80;
    server_name codigoqr.mabelgroup.com.ec;

    # Redirigir todo HTTP a HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name codigoqr.mabelgroup.com.ec;

    # Certificados SSL (ajustar rutas segun el servidor)
    ssl_certificate /etc/letsencrypt/live/codigoqr.mabelgroup.com.ec/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/codigoqr.mabelgroup.com.ec/privkey.pem;

    # Opcion A: servir dist directamente en host
    # root /storage/scnexus-front/dist;
    # index index.html;

    # QR legado PHP: excluir del proxy a la SPA (ajustar root/php-fpm segun el servidor).
    # location ^~ /checkin/ {
    #     alias /var/www/codigoqr-legacy/checkin/;
    #     index index.php;
    #     location ~ \.php$ { include snippets/fastcgi-php.conf; fastcgi_pass unix:/run/php/php-fpm.sock; }
    # }

    # Opcion B (recomendada con Docker): frontend en contenedor
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Fallback SPA si se usa Opcion A (root local).
    # location / {
    #     try_files $uri $uri/ /index.html;
    # }

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
}
