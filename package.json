{
  "name": "scnexus-front",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "env:local": "node scripts/ensure-active-env.mjs",
    "core:dev": "node scripts/switch-core.mjs dev",
    "core:prod": "node scripts/switch-core.mjs prod",
    "core:dev:up": "npm run core:dev && npm run docker:up",
    "core:prod:up": "npm run core:prod && npm run docker:up",
    "docker:up": "npm run predev && docker compose --env-file deploy/env/active.env up -d --build",
    "docker:rebuild": "npm run predev && docker compose --env-file deploy/env/active.env build --no-cache && docker compose --env-file deploy/env/active.env up -d",
    "predev": "node scripts/ensure-active-env.mjs",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:mba3": "playwright test tests/e2e/mba3-async.spec.ts tests/e2e/mba3-plantilla-async.spec.ts",
    "sync:openapi": "powershell -NoProfile -File scripts/sync-openapi-from-mba3.ps1",
    "test:e2e:mba3:live": "playwright test tests/e2e/mba3-async-live.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@azure/msal-browser": "^5.17.1",
    "@zxing/browser": "^0.2.0",
    "axios": "^1.13.2",
    "jwt-decode": "^4.0.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@types/jwt-decode": "^2.2.1",
    "@types/node": "^24.10.4",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/ui": "^4.0.18",
    "@vue/runtime-core": "^3.5.24",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.16",
    "baseline-browser-mapping": "^2.9.19",
    "happy-dom": "^20.4.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.1.0"
  }
}
